---
const { placeholder = "Pesquisar abreviação..." } = Astro.props;
---

<div class="search-wrapper">
  <fieldset>
    <legend class="sr-only">Pesquise a abreviação</legend>
    <label for="search" class="sr-only">Pesquisar termo</label>
    <input
      type="text"
      id="search"
      placeholder={placeholder}
      class="search-input"
      oninput="filterVerbetes(this.value)"
    />
    <span class="search-icon" aria-hidden="true">{"\u{1F50D}"}</span>
  </fieldset>
</div>

<div id="no-results" class="no-results" hidden>
  <p>
    Nenhum verbete encontrado. Que tal <a href="/contribuir"
      >contribuir com um novo</a
    >?
  </p>
</div>

<script>
  function filterVerbetes(query: string) {
    const q = query.toLowerCase().trim();
    const cards = document.querySelectorAll(".verbete-card");
    let found = false;

    for (const card of cards) {
      const text = (card as HTMLElement).dataset.search || "";
      const match = !q || text.includes(q);
      (card as HTMLElement).hidden = !match;
      if (match) found = true;
    }

    const noResults = document.getElementById("no-results");
    if (noResults) noResults.hidden = found || !q;
  }

  (window as any).filterVerbetes = filterVerbetes;
</script>
