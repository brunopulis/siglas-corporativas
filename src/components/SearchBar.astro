---
const { placeholder = "Pesquisar abreviação..." } = Astro.props;
---

<div class="search-wrapper">
  <input
    type="text"
    id="search"
    placeholder={placeholder}
    class="search-input"
    oninput="filterVerbetes(this.value)"
  />
  <span class="search-icon">{'\u{1F50D}'}</span>
</div>

<div id="no-results" class="no-results" hidden>
  {`\u{1F973}`} Nenhum verbete encontrado. Que tal <a href="/contribuir">contribuir com um novo</a>?
</div>

<script>
  function filterVerbetes(query: string) {
    const q = query.toLowerCase().trim();
    const cards = document.querySelectorAll('.verbete-card');
    let found = false;

    for (const card of cards) {
      const text = (card as HTMLElement).dataset.search || '';
      const match = !q || text.includes(q);
      (card as HTMLElement).hidden = !match;
      if (match) found = true;
    }

    const noResults = document.getElementById('no-results');
    if (noResults) noResults.hidden = found || !q;
  }

  (window as any).filterVerbetes = filterVerbetes;
</script>

<style>
  .search-wrapper {
    position: relative;
    margin-bottom: 1.5rem;
  }

  .search-input {
    width: 100%;
    padding: 1rem 1.2rem 1rem 3rem;
    font-size: 1.1rem;
    border: 3px solid rgba(0, 104, 56, 0.3);
    border-radius: 50px;
    background: var(--bg-card);
    color: var(--text);
    outline: none;
    transition: all 0.2s;
  }

  .search-input:focus {
    border-color: var(--blue-br);
    box-shadow: 0 0 0 4px rgba(27, 58, 107, 0.15);
  }

  .search-input::placeholder { color: var(--text-light); }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.3rem;
  }

  .no-results {
    text-align: center;
    padding: 2rem;
    font-size: 1.1rem;
    color: var(--text-light);
  }

  .no-results a { color: var(--blue-br); font-weight: 600; }
</style>
