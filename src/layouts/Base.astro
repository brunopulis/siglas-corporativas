---
import "../styles/global.css";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Dicionário Informal - Glossário colaborativo de abreviações e gírias do ambiente corporativo dos EUA"
    />
    <title>{title} | Dicionário Informal</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="#main-content" class="sr-only">Ir para conteúdo principal</a>
    <header>
      <h1>
        <a href="/"><span aria-hidden="true">📖</span> Dicionário Informal</a>
      </h1>
      <p>O guia descontraído das abreviações corporativas internacionais</p>
    </header>

    <nav>
      <a href="/"><span aria-hidden="true">🏠</span> Home</a>
      <a href="/categorias"><span aria-hidden="true">📂</span> Categorias</a>
      <a href="/contribuir"><span aria-hidden="true">✍️</span> Contribuir</a>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <p>
        Feito com <span role="img" aria-label="amor">💜</span> por <a
          href="https://github.com/anomalyco/opencode">colaboradores</a
        > • Dicionário Informal • <a href="https://github.com"
          >Contribua no GitHub</a
        >
      </p>
    </footer>
  </body>
</html>
